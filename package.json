{
  "name": "diamond-car-application",
  "private": true,
  "scripts": {
  "dev:server": "npm --prefix Server run dev",
  "dev:stripe": "stripe listen --forward-to localhost:8000/stripe/webhook",
  "dev:mobile": "cd Client/mobile-app && flutter run",
  "dev:portal": "npm --prefix Client/management-portal run dev",
  "dev": "concurrently --kill-others-on-fail --names SERVER,STRIPE,FLUTTER,PORTAL --prefix-colors blue,magenta,green,cyan \"npm run dev:server\" \"npm run dev:stripe\" \"npm run dev:mobile\" \"npm run dev:portal\""
  },
  "dependencies": {
    "cloudinary": "^1.41.3",
    "dotenv": "^17.4.2",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
